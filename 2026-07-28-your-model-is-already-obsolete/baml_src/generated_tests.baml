// Deliberate inverse of the usual trap: the document DOES show a tax line
// that happens to read 0.00, and the policy says to report an explicit tax
// line even at zero. Distinguishes 'no tax line' from 'a tax line of zero'
// — a distinction the first draft of the policy got wrong, demanding 0.00
// while also forbidding it.
test zero_tax_stated_explicitly {
  functions [ExtractExpense]
  args {
    document #"
      OFFICE DEPOT - RECEIPT 11823
      Desk lamp, 2 @ 34.50 ................ 69.00
      Subtotal ............................ 69.00
      Tax .................................. 0.00
      TOTAL ............................... 69.00
    "#
  }
  @@assert(category, {{this.category == "Hardware"}})
  @@assert(total, {{this.total == 69.0}})
  @@assert(line_items, {{this.line_items|length == 1}})
  @@assert(tax_present, {{this.tax != none}})
}

// Both a service charge AND a real tax. tax must be 62.00, not 100.75.
// Hardest tax case in the corpus.
test service_charge_and_real_tax {
  functions [ExtractExpense]
  args {
    document #"
      THE IVY - TABLE 8
      Set menu, 5 @ 62.00 ................ 310.00
      Subtotal ........................... 310.00
      Service charge 12.5% ................ 38.75
      VAT 20% ............................. 62.00
      TOTAL .............................. 410.75
    "#
  }
  @@assert(category, {{this.category == "Meals"}})
  @@assert(total, {{this.total == 410.75}})
  @@assert(line_items, {{this.line_items|length == 1}})
  @@assert(tax_present, {{this.tax != none}})
}

// Tax-inclusive pricing: total equals subtotal because the tax is already
// inside it. Tests that the model does not add the tax on top. Foreign-
// language labels are a secondary distractor.
test tax_inclusive_pricing {
  functions [ExtractExpense]
  args {
    document #"
      BERLIN CAFE - BELEG 4412
      Mittagsmenu, 3 @ 18.00 .............. 54.00
      Subtotal ............................ 54.00
      enthaltene MwSt 19% ................. 10.26
      GESAMT .............................. 54.00
    "#
  }
  @@assert(category, {{this.category == "Meals"}})
  @@assert(total, {{this.total == 54.0}})
  @@assert(line_items, {{this.line_items|length == 1}})
  @@assert(tax_present, {{this.tax != none}})
}

// Negative line item. Checks the model keeps the sign.
test discount_before_tax {
  functions [ExtractExpense]
  args {
    document #"
      FIGMA - INVOICE 88120
      Org seats, 20 @ 45.00 ............... 900.00
      Annual discount, 1 @ -90.00 ......... -90.00
      Subtotal ........................... 810.00
      Sales tax 8% ........................ 64.80
      TOTAL .............................. 874.80
    "#
  }
  @@assert(category, {{this.category == "Software"}})
  @@assert(total, {{this.total == 874.8}})
  @@assert(line_items, {{this.line_items|length == 2}})
  @@assert(tax_present, {{this.tax != none}})
}
