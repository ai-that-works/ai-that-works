// GENERATED BY harness/testgen.py — DO NOT EDIT BY HAND.
//
// Source of truth is harness/corpus.py. Regenerate with:
//     uv run python -m harness.testgen
//
// These exist so `baml-cli optimize` has a corpus; it reads BAML test
// blocks and nothing else. Assertions use `none`, never `null` — BAML's
// Jinja has no `null` literal, so `== null` is always false and silently
// makes every candidate fail.

// Mixed lodging + meals. Policy: categorise by largest line item, so room
// (378.00) wins and this is Travel. Tempting wrong answers are Meals and
// Other.
test hotel_folio {
  functions [ExtractExpense]
  args {
    document #"
      THE LANGHAM - FOLIO 4471
      Room, 2 nights @ 189.00 ............ 378.00
      Breakfast, 2 @ 24.50 ................ 49.00
      Subtotal ........................... 427.00
      Occupancy tax (12%) ................. 51.24
      Amount charged ..................... 478.24
    "#
  }
  @@assert(category, {{this.category == "Travel"}})
  @@assert(total, {{this.total == 478.24}})
  @@assert(line_items, {{this.line_items|length == 2}})
  @@assert(tax_present, {{this.tax != none}})
}

// Policy states conference and event fees are Other, never Travel. Without
// the policy this label would be arguable; with it, 'Travel' is
// objectively wrong.
test conference_pass {
  functions [ExtractExpense]
  args {
    document #"
      RE:WORK CONFERENCE - RECEIPT 2210
      Conference pass, 1 @ 899.00 ........ 899.00
      Workshop add-on, 1 @ 150.00 ........ 150.00
      Subtotal .......................... 1049.00
      TOTAL ............................. 1049.00
      (no tax collected)
    "#
  }
  @@assert(category, {{this.category == "Other"}})
  @@assert(total, {{this.total == 1049.0}})
  @@assert(line_items, {{this.line_items|length == 2}})
  @@assert(tax_omitted, {{this.tax == none}})
}

// Optional-field trap: tax must be omitted, not emitted as 0.0.
test saas_no_tax {
  functions [ExtractExpense]
  args {
    document #"
      CLOUDSPEND LTD - INVOICE 88214
      Item                          Qty   Unit      Amount
      Datadog seat licence            3   42.00     126.00
      Terraform Cloud add-on          1   19.50      19.50
      --------------------------------------------------
      Subtotal                                     145.50
      TOTAL DUE                                    145.50
      No tax applied (reverse charge).
    "#
  }
  @@assert(category, {{this.category == "Software"}})
  @@assert(total, {{this.total == 145.5}})
  @@assert(line_items, {{this.line_items|length == 2}})
  @@assert(tax_omitted, {{this.tax == none}})
}

// Software vendor, but the largest line is physical goods. Policy:
// Hardware regardless of vendor, categorise by largest line. Vendor name
// is the trap.
test monitor_on_software_invoice {
  functions [ExtractExpense]
  args {
    document #"
      JETBRAINS RESELLER - INV 5512
      IntelliJ licence renewal, 1 @ 599.00 .... 599.00
      Dell U2723QE monitor, 2 @ 610.00 ....... 1220.00
      Subtotal .............................. 1819.00
      VAT 20% ................................ 363.80
      Total ................................. 2182.80
    "#
  }
  @@assert(category, {{this.category == "Hardware"}})
  @@assert(total, {{this.total == 2182.8}})
  @@assert(line_items, {{this.line_items|length == 2}})
  @@assert(tax_present, {{this.tax != none}})
}

// Service charge is NOT tax under the policy, so tax must be omitted.
// Tests that the model distinguishes a government tax from a gratuity
// instead of stuffing any trailing percentage into the tax field.
test client_dinner {
  functions [ExtractExpense]
  args {
    document #"
      OSTERIA FRANCESCANA
      Table 12 - 4 covers
      Tasting menu, 4 @ 210.00 ........... 840.00
      Wine pairing, 2 @ 95.00 ............ 190.00
      Subtotal ......................... 1030.00
      Service 12% ....................... 123.60
      TOTAL ............................ 1153.60
    "#
  }
  @@assert(category, {{this.category == "Meals"}})
  @@assert(total, {{this.total == 1153.6}})
  @@assert(line_items, {{this.line_items|length == 2}})
  @@assert(tax_omitted, {{this.tax == none}})
}

// Meals-during-travel rule vs largest-line rule. Rail (142.50) dominates,
// so Travel. Checks the model applies the tie-break rather than fixating
// on the word 'sandwich'.
test rail_and_sandwich {
  functions [ExtractExpense]
  args {
    document #"
      TRAINLINE - BOOKING TL88301
      London -> Edinburgh, 1 @ 142.50 .... 142.50
      Onboard sandwich, 1 @ 6.50 .......... 6.50
      Subtotal ........................... 149.00
      TOTAL .............................. 149.00
      No VAT on rail travel.
    "#
  }
  @@assert(category, {{this.category == "Travel"}})
  @@assert(total, {{this.total == 149.0}})
  @@assert(line_items, {{this.line_items|length == 2}})
  @@assert(tax_omitted, {{this.tax == none}})
}

