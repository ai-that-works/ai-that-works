// Inverts hotel_folio: food (288.00) beats lodging (110.00), so the
// precedence rule makes this Meals, not Travel.
test room_service_exceeds_room {
  functions [ExtractExpense]
  args {
    document #"
      HOTEL FOLIO 8871 - EXTENDED STAY
      Room, 1 night @ 110.00 ............. 110.00
      Restaurant charges, 6 @ 48.00 ...... 288.00
      Subtotal ........................... 398.00
      City tax ............................ 31.84
      TOTAL .............................. 429.84
    "#
  }
  @@assert(category, {{this.category == "Meals"}})
  @@assert(total, {{this.total == 429.84}})
  @@assert(line_items, {{this.line_items|length == 2}})
  @@assert(tax_present, {{this.tax != none}})
}

